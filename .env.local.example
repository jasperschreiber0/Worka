# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
# From address for outbound client emails (quotes, variation notices, drafts).
# Defaults to hello@getworka.com if unset.
EMAIL_FROM_ADDRESS=

# Morning brief cron (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
# Demo-mode test recipient for the daily brief email
MORNING_BRIEF_TEST_EMAIL=

# ─── Reserved — not implemented yet ────────────────────────────────────────
# No code in this repo reads these. Setting them does nothing until SMS
# notifications / payment collection are actually built.

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Payments (Stripe)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email OAuth (for email sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
